# Builds: the publishing workflow makes them fresh from a tag
dist/
build/
*.egg-info/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node data and keys: never commit a chain database or a wallet
*.sqlite3
*.sqlite3-*
node-data/
*-data/
wallet.json
*-cert.pem
*-key.pem

# Editors and the OS
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
.DS_Store


# API Keys
.env.local
.env
.env.*

# What agents/architect.py writes by default (chats, eval prompts, answers, grades)
agent-jobs/

# Claude Code worktrees (isolated checkouts of this repo) and the SDD plan workspace
.claude/worktrees/
.superpowers/

# Browser-automation scratch output
.playwright-mcp/
# Editor and tool backup copies
*.bak
# A wallet's recovery words, written next to where it was made: never commit them
recovery-words-*.txt
# Release files built by the publish workflow, not hand-committed
dist/release.json
dist/release.sig
dist/requirements-*.txt
# The node health check's last result (deploy/healthcheck.sh)
health.json
# Onion-service hostname copies: a hidden service's address is operational detail
*.onion
